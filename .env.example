# Copia este fichero como .env y rellena los valores.

# Secreto para firmar las sesiones. Genera uno con: npx auth secret
AUTH_SECRET=

# OAuth App de GitHub (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Necesario al autoalojar detrás de tu propio dominio o proxy.
AUTH_TRUST_HOST=true

# Dónde se guarda la base de datos SQLite.
DATABASE_PATH=./data/aprende.db
